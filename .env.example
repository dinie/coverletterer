# Copy to .env and fill in. The Reflex app reads these at runtime.

# --- LLM (Claude) ---
# Required. Generates the cover letter from the resume + job description.
ANTHROPIC_API_KEY=sk-ant-...

# --- Passwordless email sign-in (SMTP) ---
# Optional. Set all three to enable the "Email me a sign-in link" option on the
# login page. Use your mail provider's SMTP credentials (e.g. an app password).
SMTP_HOSTNAME=
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional SMTP tuning:
# SMTP_PORT=587                 # 587 (STARTTLS, default) or 465 (set STARTTLS=false)
# SMTP_STARTTLS=true            # set "false" for an SSL-on-connect port like 465
# SMTP_FROM=CoverLetterer <no-reply@example.com>   # defaults to SMTP_USERNAME
# MAGIC_LINK_TTL_MINUTES=15

# --- Object storage (REQUIRED — uploaded/overridden resume PDFs live here) ---
# Local: start `docker compose up -d` (MinIO) and use these values.
AWS_ENDPOINT_URL_S3=http://localhost:9000
BUCKET_NAME=coverletterer
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=auto
# PRESIGN_TTL_SECONDS=3600        # how long resume-file URLs stay valid

# --- Database ---
# Optional for local dev (defaults to local SQLite: sqlite:///reflex.db).
# REQUIRED for Fly.io deployment (./deploy.sh refuses to deploy without it) —
# see DEPLOY.md "Database (Supabase)". Use the Supabase "Session pooler"
# connection string (port 5432), not the Transaction pooler or the direct
# connection:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=

# --- Frontend/backend URLs (used to build the magic-link verify URL) ---
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:8000

# --- Static assets bucket (deploy-time only — REQUIRED for Fly.io deploy) ---
# Not read by the app itself; ./deploy.sh reads these locally to upload the
# exported SPA's hashed JS/CSS to a dedicated Tigris bucket that Fly serves
# directly via [[statics]] (see DEPLOY.md "Static assets (Tigris)"). One-time
# setup: `fly storage create --app coverletterer-backend --name coverletterer-frontend`
# and paste its printed credentials below.
# FRONTEND_BUCKET_NAME=coverletterer-frontend
# FRONTEND_AWS_ACCESS_KEY_ID=
# FRONTEND_AWS_SECRET_ACCESS_KEY=
# FRONTEND_AWS_ENDPOINT_URL_S3=
# FRONTEND_AWS_REGION=auto

# --- Custom domain (deploy-time only) ---
# Optional. A domain CNAME'd to the fly.dev URL; deploy.sh provisions the
# TLS cert and wires it in. See DEPLOY.md "Custom domain".
# APP_DOMAIN=
